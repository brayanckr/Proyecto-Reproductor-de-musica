{
  "name": "uccplay",
  "version": "1.0.0",
  "description": "UCCplay - institutional music player built on a TypeScript Doubly Linked List.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:core && npm run typecheck && vite build && npm run verify:build",
    "build:core": "tsc -p tsconfig.core.json",
    "build:pages": "npm run build:core && npm run typecheck && vite build --base=/uccplay/ && npm run verify:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "demo": "npm run build:core && node dist/demo.js",
    "watch": "tsc -p tsconfig.core.json --watch",
    "deploy:pages": "npm run build:pages && gh-pages -d dist-web -t"
  },
  "keywords": [
    "data-structures",
    "doubly-linked-list",
    "typescript",
    "music-player",
    "uccplay"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "gh-pages": "^6.2.0",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
