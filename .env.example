# Copy this file to ".env" and fill in your own keys.

# YouTube Data API v3 key: used for live "YouTube Music" search.
VITE_YOUTUBE_API_KEY=tu_clave_de_youtube_aqui

# Groq API key (starts with gsk_): used for AI mood recommendations.
VITE_GROQ_API_KEY=tu_clave_de_groq_aqui

# Groq model id used for recommendations.
# Default: openai/gpt-oss-20b. Set a Llama-3 model if your account has access.
VITE_GROQ_MODEL=openai/gpt-oss-20b
